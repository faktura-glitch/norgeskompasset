{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "norges-kompasset-pro",
          "appId": "1:1000927215680:android:a60d24682789bd69a6dfa5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "norges-kompasset-pro",
          "configurations": {
            "android": "1:1000927215680:android:a60d24682789bd69a6dfa5",
            "ios": "1:1000927215680:ios:b3513b3c5802e63fa6dfa5",
            "web": "1:1000927215680:web:dd51fabfce53a41ca6dfa5"
          }
        }
      }
    }
  }
}

rules_version = '2';

// NorgesKompasset: every user owns a private trips collection at
// users/{uid}/trips/{tripId}. Nothing is readable by other users.
service cloud.firestore {
  match /databases/{database}/documents {

    // App admins: uids listed in config/admins.uids (array). The list is
    // maintained in the Firebase console only.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in
             get(/databases/$(database)/documents/config/admins).data.uids;
    }

    match /config/admins {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tour calendar written hourly by the refreshEvents Cloud Function.
    // Public read so the calendar shows without signing in.
    match /config/events {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      // The user document itself (profile, settings, etc.)
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      match /trips/{tripId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // Shared trip snapshots: readable by any signed-in user who has
    // the code; only the owner may create/update/delete the doc.
    // `get` only — `list` would let anyone enumerate every shared trip.
    match /sharedTrips/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.owner == request.auth.uid;
    }

    // Tour catalog: readable by any signed-in user; only the
    // publishing owner may write the entry.
    match /catalogTrips/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      // The owner — or an admin — may remove an entry.
      allow delete: if request.auth != null
                    && (resource.data.owner == request.auth.uid || isAdmin());
      // The owner may update everything. Other signed-in users may
      // only add their own uid to reportedBy (abuse reports).
      allow update: if request.auth != null && (
        resource.data.owner == request.auth.uid ||
        (request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['reportedBy'])
         && request.resource.data.reportedBy is list
         && request.resource.data.reportedBy.hasAll(
              'reportedBy' in resource.data ? resource.data.reportedBy : [])
         && request.resource.data.reportedBy.hasOnly(
              resource.data.get('reportedBy', []).concat([request.auth.uid])))
      );
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
